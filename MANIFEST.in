include README.md pyproject.toml server.py main.py
recursive-include config *.py
recursive-include src *.py *.json *.tcss
recursive-include src *.md
prune tests
prune agent-gui
prune data
prune docs
prune openspec
prune build
prune dist
prune .agents
prune .codex
prune .git
global-exclude .env .env.* *.py[cod] *.pem *.key
