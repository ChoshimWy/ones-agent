Screen {
    layout: vertical;
}

#setup-wizard {
    width: 100%;
    height: 100%;
}

#setup-shell {
    width: 100%;
    height: 1fr;
}

#setup-navigation {
    width: 22;
    border-right: solid $primary;
    padding: 1;
}

#setup-form {
    width: 1fr;
    padding: 1 2;
}

#setup-summary {
    width: 28;
    border-left: solid $primary;
    padding: 1;
}

.setup-step {
    width: 100%;
    height: auto;
}

.setup-step Input,
.setup-step Button {
    width: 100%;
    margin-bottom: 1;
}

.setup-nav-button {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
}

#setup-actions {
    width: 100%;
    height: 3;
}

#setup-actions Button {
    width: 1fr;
}

#setup-wizard.two #setup-summary {
    display: none;
}

#setup-wizard.two #setup-navigation {
    width: 20;
}

#setup-wizard.one #setup-navigation,
#setup-wizard.one #setup-summary {
    display: none;
}

#dashboard {
    width: 100%;
    height: 1fr;
}

#action-bar {
    height: 3;
}

#action-bar Button {
    width: 1fr;
}

#notice,
#modal-notice {
    height: 1;
}

ApprovalModal,
RevisionModal,
CancelModal,
PublicationResumeModal {
    layout: vertical;
}

ApprovalModal > VerticalScroll,
RevisionModal > VerticalScroll,
CancelModal > VerticalScroll,
PublicationResumeModal > VerticalScroll {
    height: 1fr;
}

#navigation {
    width: 22;
    padding: 1;
    border-right: solid $primary;
}

#navigation Button {
    width: 100%;
    margin-bottom: 1;
}

#workspace {
    width: 1fr;
    height: 100%;
}

#run-list-pane {
    width: 34;
    height: 100%;
    border-right: solid $primary;
}

#run-detail {
    width: 1fr;
    height: 100%;
}

.pane-title {
    text-style: bold;
    padding: 0 1;
}

#settings {
    display: none;
    width: 1fr;
    height: 100%;
    padding: 2;
}

#dashboard.two #navigation,
#dashboard.one #navigation {
    display: none;
}

#dashboard.two #run-list-pane {
    width: 32;
}

#dashboard.one #run-list-pane {
    width: 1fr;
    border-right: none;
}

#dashboard.one #run-detail {
    display: none;
}

#run-detail-screen #run-detail {
    display: block;
    width: 100%;
    height: 100%;
}
