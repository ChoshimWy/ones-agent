Screen {
    layout: vertical;
}

#dashboard {
    width: 100%;
    height: 1fr;
}

#action-bar {
    height: 3;
}

#action-bar Button {
    width: 1fr;
}

#notice,
#modal-notice {
    height: 1;
}

ApprovalModal,
RevisionModal,
CancelModal,
PublicationResumeModal {
    layout: vertical;
}

ApprovalModal > VerticalScroll,
RevisionModal > VerticalScroll,
CancelModal > VerticalScroll,
PublicationResumeModal > VerticalScroll {
    height: 1fr;
}

#navigation {
    width: 22;
    padding: 1;
    border-right: solid $primary;
}

#navigation Button {
    width: 100%;
    margin-bottom: 1;
}

#workspace {
    width: 1fr;
    height: 100%;
}

#run-list-pane {
    width: 34;
    height: 100%;
    border-right: solid $primary;
}

#run-detail {
    width: 1fr;
    height: 100%;
}

.pane-title {
    text-style: bold;
    padding: 0 1;
}

#settings {
    display: none;
    width: 1fr;
    height: 100%;
    padding: 2;
}

#dashboard.two #navigation,
#dashboard.one #navigation {
    display: none;
}

#dashboard.two #run-list-pane {
    width: 32;
}

#dashboard.one #run-list-pane {
    width: 1fr;
    border-right: none;
}

#dashboard.one #run-detail {
    display: none;
}

#run-detail-screen #run-detail {
    display: block;
    width: 100%;
    height: 100%;
}
