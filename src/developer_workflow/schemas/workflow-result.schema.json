{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aputure.local/schemas/workflow-result.schema.json",
  "title": "Codex developer workflow result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_needs",
    "summary",
    "changed_files",
    "repository_changes",
    "commands",
    "evidence",
    "review_findings",
    "review_repair_scope",
    "review_external_validation",
    "risks",
    "unresolved_items",
    "acceptance_coverage",
    "unrelated_changes_checked",
    "root_cause_evidence",
    "investigation_suggestions",
    "behavior_before",
    "behavior_after",
    "impact_scope",
    "risk_level"
  ],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_key", "path"],
        "properties": {
          "repository_key": {"type": "string"},
          "path": {"$ref": "#/$defs/repositoryPath"}
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "summary"],
        "properties": {
          "command": {"type": "string"},
          "exit_code": {"type": "integer"},
          "summary": {"type": "string"}
        }
      }
    },
    "evidence": {"$ref": "#/$defs/stringList"},
    "review_findings": {"$ref": "#/$defs/stringList"},
    "review_repair_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_key", "path"],
        "properties": {
          "repository_key": {"type": "string"},
          "path": {"$ref": "#/$defs/repositoryPath"}
        }
      }
    },
    "review_external_validation": {"$ref": "#/$defs/stringList"},
    "verification_needs": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["description", "capabilities", "acceptance"],
        "properties": {
          "description": {"type": "string", "minLength": 1, "maxLength": 4096},
          "capabilities": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,95}$"}},
          "acceptance": {"type": "string", "maxLength": 4096}
        }
      }
    },
    "risks": {"$ref": "#/$defs/stringList"},
    "unresolved_items": {"$ref": "#/$defs/stringList"},
    "acceptance_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "criterion_text", "files", "repository_files", "tests"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^AC-[1-9][0-9]*$"
          },
          "criterion_text": {"type": "string", "minLength": 1},
          "files": {
            "type": "array",
            "items": {"type": "string"}
          },
          "repository_files": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["repository_key", "path"],
              "properties": {
                "repository_key": {"type": "string"},
                "path": {"$ref": "#/$defs/repositoryPath"}
              }
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "unrelated_changes_checked": {"type": "boolean"}
    ,
    "root_cause_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/rootCauseEvidence"}
    },
    "investigation_suggestions": {"$ref": "#/$defs/stringList"},
    "behavior_before": {"type": "string"},
    "behavior_after": {"type": "string"},
    "impact_scope": {
      "type": "array",
      "items": {"$ref": "#/$defs/repositoryPath"}
    },
    "risk_level": {"type": "string", "enum": ["", "low", "medium", "high"]}
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string"}
    },
    "rootCauseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_path", "location", "start_line", "end_line", "symbol",
        "repository_file",
        "mechanism", "code_excerpt", "call_chain", "reproduction_test", "test_selector",
        "reproduction_file",
        "reproduction_command", "confidence", "insufficient_evidence",
        "impacted_files", "impacted_repository_files", "fix_steps", "supporting_points"
      ],
      "properties": {
        "file_path": {"$ref": "#/$defs/repositoryPath"},
        "repository_file": {"anyOf": [{"$ref": "#/$defs/repositoryChangeClaim"}, {"type": "null"}]},
        "location": {"type": "string", "minLength": 1},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "symbol": {"type": "string"},
        "mechanism": {"type": "string", "minLength": 1},
        "code_excerpt": {"type": "string"},
        "call_chain": {"$ref": "#/$defs/stringList"},
        "reproduction_test": {"$ref": "#/$defs/repositoryPath"},
        "reproduction_file": {"anyOf": [{"$ref": "#/$defs/repositoryChangeClaim"}, {"type": "null"}]},
        "test_selector": {"type": "string", "minLength": 1},
        "reproduction_command": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "insufficient_evidence": {"type": "boolean"},
        "impacted_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repositoryPath"}},
        "impacted_repository_files": {"type": "array", "items": {"$ref": "#/$defs/repositoryChangeClaim"}},
        "fix_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "supporting_points": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rootCauseSupportingPoint"}
        }
      }
    },
    "repositoryChangeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_key", "path"],
      "properties": {
        "repository_key": {"type": "string"},
        "path": {"$ref": "#/$defs/repositoryPath"}
      }
    },
    "rootCauseSupportingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "source", "file_path", "repository_file", "snippet", "start_line", "end_line", "direct_root_cause"],
      "properties": {
        "kind": {"enum": ["defect", "repo_resolution", "code", "cross_file"]},
        "description": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "file_path": {"type": "string"},
        "repository_file": {"anyOf": [{"$ref": "#/$defs/repositoryChangeClaim"}, {"type": "null"}]},
        "snippet": {"type": "string"},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "direct_root_cause": {"type": "boolean"}
      }
    }
  }
}
