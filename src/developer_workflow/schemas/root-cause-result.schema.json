{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aputure.local/schemas/root-cause-result.schema.json",
  "title": "Codex root-cause analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary", "risks", "unresolved_items", "root_cause_evidence",
    "investigation_suggestions", "behavior_before", "impact_scope", "risk_level"
  ],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "risks": {"$ref": "#/$defs/stringList"},
    "unresolved_items": {"$ref": "#/$defs/stringList"},
    "root_cause_evidence": {"type": "array", "items": {"$ref": "#/$defs/rootCauseEvidence"}},
    "investigation_suggestions": {"$ref": "#/$defs/stringList"},
    "behavior_before": {"type": "string"},
    "impact_scope": {"type": "array", "items": {"$ref": "#/$defs/repositoryPath"}},
    "risk_level": {"type": "string", "enum": ["", "low", "medium", "high"]}
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/:;\\\\\\u0000-\\u001F\\u007F]+(?:/[^/:;\\\\\\u0000-\\u001F\\u007F]+)*$"
    },
    "stringList": {"type": "array", "items": {"type": "string"}},
    "repositoryChangeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_key", "path"],
      "properties": {
        "repository_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "path": {"$ref": "#/$defs/repositoryPath"}
      }
    },
    "rootCauseSupportingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "description", "source", "file_path", "repository_file",
        "snippet", "start_line", "end_line", "direct_root_cause"
      ],
      "properties": {
        "kind": {"enum": ["defect", "repo_resolution", "code", "cross_file"]},
        "description": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "file_path": {
          "type": "string",
          "pattern": "^$|^[^/:;\\\\\\u0000-\\u001F\\u007F]+(?:/[^/:;\\\\\\u0000-\\u001F\\u007F]+)*$"
        },
        "repository_file": {"anyOf": [{"$ref": "#/$defs/repositoryChangeClaim"}, {"type": "null"}]},
        "snippet": {"type": "string"},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "direct_root_cause": {"type": "boolean"}
      }
    },
    "rootCauseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_path", "location", "start_line", "end_line", "symbol",
        "repository_file", "mechanism", "code_excerpt", "call_chain",
        "reproduction_test", "test_selector", "reproduction_file",
        "reproduction_command", "confidence", "insufficient_evidence",
        "impacted_files", "impacted_repository_files", "fix_steps", "supporting_points"
      ],
      "properties": {
        "file_path": {"$ref": "#/$defs/repositoryPath"},
        "location": {"type": "string", "minLength": 1},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "symbol": {"type": "string"},
        "repository_file": {"anyOf": [{"$ref": "#/$defs/repositoryChangeClaim"}, {"type": "null"}]},
        "mechanism": {"type": "string", "minLength": 1},
        "code_excerpt": {"type": "string"},
        "call_chain": {"$ref": "#/$defs/stringList"},
        "reproduction_test": {"$ref": "#/$defs/repositoryPath"},
        "test_selector": {"type": "string", "minLength": 1},
        "reproduction_file": {"anyOf": [{"$ref": "#/$defs/repositoryChangeClaim"}, {"type": "null"}]},
        "reproduction_command": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "insufficient_evidence": {"type": "boolean"},
        "impacted_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repositoryPath"}},
        "impacted_repository_files": {"type": "array", "items": {"$ref": "#/$defs/repositoryChangeClaim"}},
        "fix_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "supporting_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rootCauseSupportingPoint"}}
      }
    }
  }
}
